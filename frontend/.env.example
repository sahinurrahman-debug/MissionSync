# MissionSync frontend environment (all optional).
#
# The dashboard and the API share ONE origin: in development Vite proxies /api and /ws to the backend, and in
# production FastAPI serves the built dashboard. So there is no API URL to configure — sign-in cookies simply
# work. Start the backend (see the README) and run `npm run dev`.

# Where the dev proxy forwards /api and /ws (default http://127.0.0.1:8000).
# BACKEND_URL=http://127.0.0.1:8000

# Optional build tag.
VITE_APP_ENV=

# Map tiles: defaults to OpenStreetMap's public servers (fine for demos). For real traffic point
# this at a provider (MapTiler, Stadia, your own) and set the attribution it requires.
# VITE_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
