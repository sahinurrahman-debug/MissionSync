# MissionSync frontend environment
#
# VITE_API_URL — base URL of the MissionSync backend (FastAPI), e.g.
#   VITE_API_URL=https://missionsync-api.onrender.com
# Leave EMPTY in local development: `npm run dev` proxies /api and /ws to
# http://127.0.0.1:8000 (override with BACKEND_URL), and if no backend answers the
# app runs its in-browser DEMO engine, clearly labelled in the header.
# When set, the app talks to that backend only (an unreachable backend shows an
# offline banner instead of silently switching to the demo engine).
VITE_API_URL=

# Optional build tag.
VITE_APP_ENV=

# Map tiles: defaults to OpenStreetMap's public servers (fine for demos). For real traffic point
# this at a provider (MapTiler, Stadia, your own) and set the attribution it requires.
# VITE_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
