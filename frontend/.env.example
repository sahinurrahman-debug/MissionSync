# MissionSync (Kenshi) environment variables
#
# The Level-2 (Kenshi) build is frontend-only: the entire drill engine —
# simulator, agent pipeline, ranking, logistics — runs in the browser.
# No runtime secrets are required. This file exists so the setup contract
# matches the README and future levels drop in without surprises.

# VITE_APP_ENV — optional build tag; reserved for future levels.
# Leave empty for local development.
VITE_APP_ENV=
