[TEMPLATE]
# MissionSync backend configuration
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: pin a model (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# Kaggle API token from https://www.kaggle.com/settings (required to fetch xBD).
KAGGLE_API_TOKEN=

# Optional: a specific CSV or xBD annotation JSON path inside the dataset.
# By default the simulator fetches a small set of xBD label JSON files only.
# XBD_FILE_PATH=xbd_full/hold/labels/guatemala-volcano_00000004_post_disaster.json
