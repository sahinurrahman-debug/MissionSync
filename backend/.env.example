[TEMPLATE]
# MissionSync backend configuration
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: pin a model (default is the fast llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Scenario dataset: xBD damage assessment (rayanhossain239/damageactu-xbd-full)
# The simulator loads it via kagglehub. If the dataset or credentials are
# unavailable the sim falls back to a deterministic offline cohort.
# Optional: set this if the dataset repo ships the tabular file under a
# different name than the default (xbd_full.csv).
# XBD_FILE_PATH=
