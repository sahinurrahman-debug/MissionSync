# MissionSync backend configuration — copy to .env (never commit .env).
# Everything below is optional for local development: with no DATABASE_URL a local SQLite file is used.

# ---- Database ----------------------------------------------------------------------------
# Production: a Postgres connection string (Neon, Supabase, Render …). Migrations run automatically on start.
#   postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Development: leave empty to use ./missionsync.db (SQLite).
DATABASE_URL=

# ---- Environment -------------------------------------------------------------------------
# production → Secure cookies, and the server refuses to start on the throw-away SQLite file.
APP_ENV=development
# Days a sign-in lasts.
# SESSION_DAYS=14
# Close sign-ups on a shared server.
# ALLOW_SIGNUP=true
# Fair-use limits for a small free instance.
# MAX_DRILLS_PER_USER=10
# MAX_LIVE_DRILLS=6
# IDLE_UNLOAD_S=600

# ---- AI agents (Groq) --------------------------------------------------------------------
# Free key at https://console.groq.com/keys. Without it the agents run rule-based
# (the header says "RULES · LLM off").
GROQ_API_KEY=
# Optional: pin models. When one model's daily token quota is spent the other is used.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# ---- Scenario data -----------------------------------------------------------------------
# snapshot (default): the bundled real xBD records.  kaggle: download the live dataset.
# XBD_SOURCE=snapshot
# Kaggle API token from https://www.kaggle.com/settings (only needed for XBD_SOURCE=kaggle).
KAGGLE_API_TOKEN=
# XBD_FILE_PATH=xbd_full/hold/labels/guatemala-volcano_00000004_post_disaster.json

# ---- Browsers and proxies ----------------------------------------------------------------
# Extra origins allowed to call the API / open the WebSocket. Only needed when the dashboard is hosted on a
# DIFFERENT origin than the API (the dev servers on :5173 and :4173 are always allowed). Same-origin: leave unset.
# CORS_ORIGINS=https://my-dashboard.example.com
# Force Secure cookies outside production (e.g. a TLS-terminating reverse proxy in staging).
# COOKIE_SECURE=1
# Serve a built dashboard from this folder (the Docker image sets it; locally it falls back to ../frontend/dist).
# STATIC_DIR=

# ---- Behaviour and observability ---------------------------------------------------------
# false (default): agents PROPOSE dispatches and a human approves them. true: commit immediately (demo mode).
# AUTO_DISPATCH=false
# LOG_FORMAT=json         # json | text
# LOG_LEVEL=INFO
# SENTRY_DSN=             # optional; requires `pip install sentry-sdk`
