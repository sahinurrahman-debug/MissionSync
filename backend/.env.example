# MissionSync backend configuration (copy to .env — never commit .env)

# Groq key — free at https://console.groq.com/keys. Without it the agents run
# rule-based ("RULES · LLM off" in the dashboard header).
GROQ_API_KEY=
# Optional: pin models. When one model's daily token quota is spent the other is used.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Kaggle API token from https://www.kaggle.com/settings — optional. With it the real
# xBD label files are downloaded live; without it the bundled snapshot of the same
# real records (backend/missionsync/data/xbd_seeds.json) is used.
KAGGLE_API_TOKEN=

# Optional: a specific CSV or xBD annotation JSON path inside the dataset.
# XBD_FILE_PATH=xbd_full/hold/labels/guatemala-volcano_00000004_post_disaster.json

# Comma-separated origins allowed to call the API from a browser. The defaults cover
# the local dev servers; in production set this to your frontend's URL.
# CORS_ORIGINS=https://missionsync-web.onrender.com

# Postgres for drill history, the audit trail and reports. Render injects this for a
# linked database. Leave empty to run purely in memory.
# DATABASE_URL=postgresql://user:password@host:5432/missionsync

# ---- Operating the drill ---------------------------------------------------------
# Protects Restart / End drill / Auto-dispatch toggle (sent as X-Admin-Key). Empty = open (local dev).
# ADMIN_KEY=
# false (default): agents PROPOSE dispatches and a human approves them (PRD FR-7/FR-8).
# true: commit recommendations immediately (demo mode; the dashboard also has a toggle).
# AUTO_DISPATCH=false
# snapshot (default): bundled real xBD records.  kaggle: download the live dataset.
# XBD_SOURCE=snapshot

# ---- Observability / limits ------------------------------------------------------
# LOG_FORMAT=json         # json | text
# LOG_LEVEL=INFO
# MAX_WS_CLIENTS=200      # concurrent dashboards before new sockets get 1013
# SENTRY_DSN=             # optional; requires `pip install sentry-sdk`
